rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin & HQ Review Authority
    match /{document=**} {
      allow read, write: if request.auth != null 
                         && (request.auth.uid == "perolehan_hsaas" || request.auth.token.email == "perolehan_hsaas@upm.edu.my");
    }

    // HSAAS Staff (@upm.edu.my)
    match /{document=**} {
      allow read, write: if request.auth != null 
                         && request.auth.token.email.matches(".*@upm.edu.my$");
    }

    // Applications, budgets, logs and profiles collections
    match /applications/{appId} {
      allow read, write: if true;
    }
    match /annual_budgets/{budgetId} {
      allow read, write: if true;
    }
    match /login_logs/{logId} {
      allow read, write: if true;
    }
    match /user_profiles/{profileId} {
      allow read, write: if true;
    }

    // General fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

